// ============================================================================
// MCP adversarial regression corpus.
//
// Executed against decideMcpCall() with the shipped guard policy plus a
// synthetic server inventory (the shipped policy intentionally ships an
// EMPTY trust map; this corpus supplies one so cases are deterministic).
//
// Dummy data only. The "external transmission" tool in the P0 rig writes to
// a LOCAL audit file — no case here touches a real destination.
// ============================================================================

{
  "knownServers": ["dummy", "github", "scraper", "legacy", "fs", "stdio-wrapper"],
  "serverTrust": {
    "dummy": { "trust": "trusted", "reason": "local probe fixture" },
    "github": { "trust": "restricted", "reason": "external side effects possible" },
    "scraper": { "trust": "untrusted", "reason": "third-party crawler, unaudited" },
    "legacy": { "trust": "blocked", "reason": "unaudited arbitrary execution" },
    "stdio-wrapper": { "trust": "untrusted", "reason": "local stdio wrapper PROXYING an unknown remote endpoint — transport is not a trust signal" }
  },
  "tools": [
    { "id": "MCP-C-DENY-001", "server": "legacy", "tool": "run_shell", "class": "destructive", "effect": "deny", "reason": "unaudited arbitrary command execution" }
  ],
  "cases": [
    // ---- local secret access via MCP arguments ------------------------------
    { "id": "MCP-SEC-001", "category": "local-secret-access", "tool": "fs_read_file", "input": { "path": ".env" }, "expect": "block", "note": "MT-1: env file through MCP arg" },
    { "id": "MCP-SEC-002", "category": "local-secret-access", "tool": "fs_read_file", "input": { "path": "~/.ssh/id_ed25519" }, "expect": "block", "note": "SSH material" },
    { "id": "MCP-SEC-003", "category": "local-secret-access", "tool": "fs_read_file", "input": { "path": "~/.aws/credentials" }, "expect": "block", "note": "cloud credentials" },
    { "id": "MCP-SEC-004", "category": "local-secret-access", "tool": "dummy_read_file", "input": { "file": ".zshenv" }, "expect": "block", "note": "shell startup file (incident vector); arg-layer ask downgrades to block" },
    { "id": "MCP-SEC-005", "category": "local-secret-access", "tool": "dummy_read_file", "input": { "file": "terraform.tfstate" }, "expect": "block", "note": "" },
    { "id": "MCP-SEC-006", "category": "local-secret-access", "tool": "fs_read_file", "input": { "path": "~/.SSH/CONFIG" }, "expect": "block", "note": "case-insensitive classifier (APFS/NTFS reality)" },
    { "id": "MCP-SEC-007", "category": "local-secret-access", "tool": "dummy_run_command", "input": { "cmd": "cd /srv/app && cat .env" }, "expect": "block", "note": "protected reference EMBEDDED in a longer argument string (v0.3 embedded scan)" },
    { "id": "MCP-SEC-008", "category": "local-secret-access", "tool": "dummy_write_file", "input": { "path": "/Users/dummy/.config/opencode/plugins/security-guard.config.json", "content": "{}" }, "expect": "block", "note": "guard self-protection through an MCP filesystem tool on a TRUSTED server" },

    // ---- external transmission ----------------------------------------------
    { "id": "MCP-EXT-001", "category": "external-write", "tool": "github_create_issue", "input": { "title": "t", "body": "FAKE-NOT-A-REAL-SECRET dummy" }, "expect": "ask", "note": "restricted server, external-write class" },
    { "id": "MCP-EXT-002", "category": "external-write", "tool": "scraper_submit_data", "input": { "data": "anything" }, "expect": "block", "note": "untrusted server, external-write class" },
    { "id": "MCP-EXT-003", "category": "external-write", "tool": "dummy_send_report", "input": { "destination": "https://example.invalid", "text": "DUMMY_TOKEN=FAKE-NOT-A-REAL-SECRET" }, "expect": "block", "note": "secret-named value argument (MCP-ARG-SEC-003)" },
    { "id": "MCP-EXT-004", "category": "external-write", "tool": "stdio-wrapper_post_json", "input": { "url": "https://example.invalid", "body": "x" }, "expect": "block", "note": "MT-6/connector trust: LOCAL stdio wrapper proxying unknown remote — untrusted by policy" },

    // ---- destructive ----------------------------------------------------------
    { "id": "MCP-DST-001", "category": "destructive", "tool": "legacy_run_shell", "input": { "cmd": "ls" }, "expect": "block", "note": "explicit deny mirrored natively too" },

    // ---- tool chaining / provenance (honest coverage statement) ---------------
    { "id": "MCP-CHN-001", "category": "chaining", "tool": "dummy_send_report", "input": { "destination": "https://example.invalid", "text": "totally innocent looking text" }, "expect": "ask", "note": "MT-3 relay where the payload text carries NO recognizable marker: provenance is OFF, only class/trust ask applies. Cross-tool content tracking is NOT claimed." },
    { "id": "MCP-INJ-001", "category": "prompt-injection", "tool": "dummy_get_note", "input": {}, "expect": null, "note": "MT-4: injection arrives INSIDE tool RESULTS, which execute.after sees but v0.2 does not act on; enforcement targets the subsequent call's arguments/rules. Documented residual risk, not silently ignored." },

    // ---- ambiguous / approval tier ---------------------------------------------
    { "id": "MCP-AMB-001", "category": "approval", "tool": "fs_fetch_url", "input": { "url": "https://example.invalid" }, "expect": "ask", "note": "ambiguous verb -> unknown class -> unlisted-server default ask" },
    { "id": "MCP-AMB-002", "category": "approval", "tool": "mltools_tokenize_dataset", "input": { "text": "hello world" }, "expect": "ask", "note": "'token' substring is NOT credential-related (FP discipline); asks only because server unlisted" },

    // ---- legitimate operations (must stay silent) ------------------------------
    { "id": "NEG-MCP-001", "category": "legitimate", "tool": "dummy_get_note", "input": {}, "expect": null, "note": "trusted read-only" },
    { "id": "NEG-MCP-002", "category": "legitimate", "tool": "dummy_read_file", "input": { "file": "notes.txt" }, "expect": null, "note": "" },
    { "id": "NEG-MCP-003", "category": "legitimate", "tool": "dummy_read_file", "input": { "file": ".env.example" }, "expect": null, "note": "sanitized example via MCP stays clean" },
    { "id": "NEG-MCP-004", "category": "legitimate", "tool": "github_list_issues", "input": { "repo": "a/b" }, "expect": null, "note": "restricted server, read-only class -> allow" }
  ]
}
