    { "id": "BYP-GIT-010", "category": "git", "tool": "bash", "input": { "command": "git grep PASSWORD" }, "expect": "ask", "expectRule": "GGG-HIST", "note": "unscoped git grep reads every tracked file's contents; scoped pathspecs stay silent (NEG-FP-040)" },
    { "id": "BYP-GIT-011", "category": "git", "tool": "bash", "input": { "command": "git grep -e PASSWORD HEAD" }, "expect": "ask", "expectRule": "GGG-HIST", "note": "tree-revision search without pathspec" },
