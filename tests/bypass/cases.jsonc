    { "id": "BYP-SEC-001", "category": "secret-dir", "tool": "bash", "input": { "command": "cat ~/.secrets/api_keys" }, "expect": "ask", "expectPathRule": "GG-SEC", "note": "~/.secrets was unprotected (only ~/.config/secrets was)" },
    // Tool-adapter gaps: bracket glob text, broad-root grep tool.
    { "id": "BYP-GLB-006", "category": "glob-expansion", "tool": "glob", "input": { "pattern": "[.]env" }, "expect": "ask", "expectRule": "GG-ENV-001+GLOB", "note": "bracket class survives text stripping and matches .env; **/*.log stays silent (NEG-FP-046)" },
    { "id": "BYP-GLB-007", "category": "glob-expansion", "tool": "glob", "input": { "pattern": "[.]e[n]v" }, "expect": "ask", "expectRule": "GG-ENV-001+GLOB", "note": "multi-bracket variant" },
