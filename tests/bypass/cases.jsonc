    { "id": "BYP-IND-014", "category": "indirection", "tool": "bash", "input": { "command": "X=FAKE_SECRET; echo ${(P)X}" }, "expect": "block", "expectRule": "GGE-VAR", "note": "F1: zsh (P) flag was invisible to varRefs; dummy NAME only" },
