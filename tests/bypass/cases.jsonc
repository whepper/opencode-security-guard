    { "id": "BYP-KEY-006", "category": "credential-cli", "tool": "bash", "input": { "command": "npm config get _authToken" }, "expect": "ask", "expectRule": "GGE-CLI", "note": "npm config get registry stays silent (NEG-FP-038)" },
