    { "id": "BYP-QTE-003", "category": "quoting", "tool": "bash", "input": { "command": "cat .e\\nv" }, "expect": "block", "note": "backslash escape" },
    { "id": "BYP-QTE-004", "category": "quoting", "tool": "bash", "input": { "command": "base64 './.e\"\"nv'" }, "expect": "block", "note": "quotes inside a quoted argument" },

    // ---- re-entry wrappers (bash -c / eval / env / sudo / watch ...) ---------
