    { "id": "BYP-GIT-008", "category": "git", "tool": "bash", "input": { "command": "git show HEAD" }, "expect": "ask", "expectRule": "GGG-HIST", "note": "E4 fixed" },
    { "id": "BYP-GIT-009", "category": "git", "tool": "bash", "input": { "command": "git archive main -o /tmp/a.tar" }, "expect": "ask", "expectRule": "GGG-HIST", "note": "E4 fixed: full-tree archive without pathspec" },
