    { "id": "BYP-ARC-005", "category": "archives", "tool": "bash", "input": { "command": "zip -r /tmp/s.zip ." }, "expect": "ask", "expectRule": "GGA-DIR", "note": "E3 fixed" },
    // Bare history / full-tree git carries no pathspec.
