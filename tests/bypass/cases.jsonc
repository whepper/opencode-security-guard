    { "id": "BYP-IND-010", "category": "indirection", "tool": "bash", "input": { "command": "A=FAKE_SECRET; echo $A" }, "expect": "block", "expectRule": "GGE-VAR", "note": "F1: assignment chain resolves to a secret-named variable; dummy NAME only" },
