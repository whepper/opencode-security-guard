    { "id": "BYP-SRC-009", "category": "search", "tool": "grep", "input": { "pattern": "PASSWORD=", "path": "" }, "expect": "ask", "expectRule": "GGR-SEARCH", "note": "empty path = default (cwd) recursive search" },

