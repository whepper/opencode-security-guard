    { "id": "BYP-IND-007", "category": "indirection", "tool": "bash", "input": { "command": "A=B; B=.env; cat ${!A}" }, "expect": "block", "note": "bash indirect expansion resolved through the assignment chain" },
    { "id": "BYP-IND-008", "category": "indirection", "tool": "bash", "input": { "command": "cat$IFS.env" }, "expect": "block", "note": "$IFS used as an argument separator" },
