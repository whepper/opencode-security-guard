    { "id": "BYP-WRT-003", "category": "deferred-execution", "tool": "write", "input": { "filePath": "steal.sh", "content": "cat ~/.zshenv" }, "expect": "ask", "expectRule": "GGW-CONTENT-002", "note": "F2: ask-tier body references (the incident class) prompt at write time; deny-tier stays GGW-CONTENT-001 (BYP-WRT-001)" },
    { "id": "BYP-WRT-004", "category": "deferred-execution", "tool": "write", "input": { "filePath": "run.ps1", "content": "Get-Content .env" }, "expect": "ask", "expectRule": "GGW-CONTENT-001", "note": "F3: .ps1 was not in SCRIPT_EXT_RE" },
