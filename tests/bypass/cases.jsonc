    // ---- re-entry wrappers (bash -c / eval / env / sudo / watch ...) ---------
    { "id": "BYP-WRP-001", "category": "wrapper-reentry", "tool": "bash", "input": { "command": "bash -c 'echo $AWS_SECRET_ACCESS_KEY'" }, "expect": "block", "expectRule": "GGE-VAR", "note": "printer hidden behind a shell re-entry" },
    { "id": "BYP-WRP-002", "category": "wrapper-reentry", "tool": "bash", "input": { "command": "sh -c 'printenv'" }, "expect": "block", "expectRule": "GGE-DUMP", "note": "environment dump hidden behind a shell re-entry" },
