    // ---- case-insensitive filesystems (v0.3: classifier lowercases paths) ----
    { "id": "BYP-CAS-001", "category": "case-insensitivity", "tool": "bash", "input": { "command": "cat .ENV" }, "expect": "block", "note": "APFS/NTFS are case-insensitive: .ENV IS .env" },
    { "id": "BYP-CAS-002", "category": "case-insensitivity", "tool": "bash", "input": { "command": "cat ID_RSA" }, "expect": "block", "note": "" },
