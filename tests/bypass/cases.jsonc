    { "id": "BYP-WRP-005", "category": "wrapper-reentry", "tool": "bash", "input": { "command": "watch -n 1 cat .env" }, "expect": "block", "note": "" },
    { "id": "BYP-WRP-006", "category": "wrapper-reentry", "tool": "bash", "input": { "command": "sudo sh -c 'cat .env'" }, "expect": "block", "note": "nested wrappers" },
