    { "id": "BYP-CAS-004", "category": "case-insensitivity", "tool": "read", "input": { "filePath": "/Users/dummy/.AWS/CREDENTIALS" }, "expect": "block", "note": "read-tool variant of the same class" },
    { "id": "BYP-CAS-005", "category": "case-insensitivity", "tool": "bash", "input": { "command": "cat ~/.SSH/../README.md" }, "expect": "block", "note": "DELIBERATE conservatism: any .ssh path component denies, even one traversal walks out of. Relaxing it would reopen ~/.aws/../.ssh/id_rsa." },

    // ---- shell quoting/backslash artifacts (token normalization) -------------
