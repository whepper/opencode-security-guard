    { "id": "BYP-SRC-007", "category": "search", "tool": "glob", "input": { "pattern": "**/.zshenv" }, "expect": "ask", "expectRule": "GG-RC-001+GLOB", "note": "E10 fixed: ask-tier discovery asks; **/*.log stays silent" },
    // procfs environment: narrow deny/ask scoped to /proc.
