    // Shell-history files (past secrets live here).
    { "id": "BYP-HIS-001", "category": "history", "tool": "bash", "input": { "command": "cat ~/.zsh_history" }, "expect": "ask", "expectPathRule": "GG-HIS", "note": "incident-adjacent: history stores past exports" },
    { "id": "BYP-HIS-002", "category": "history", "tool": "bash", "input": { "command": "cat ~/.bash_history" }, "expect": "ask", "expectPathRule": "GG-HIS", "note": "" },
