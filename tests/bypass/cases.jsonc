    // Editor backup/autosave names escape prefix/suffix matching.
    { "id": "BYP-BAK-001", "category": "backup-names", "tool": "read", "input": { "filePath": ".env~" }, "expect": "block", "expectRule": "GG-ENV-001", "note": "vi/cp backup of .env; classified as its original; .env.example~ stays silent (NEG-FP-042)" },
    { "id": "BYP-BAK-002", "category": "backup-names", "tool": "read", "input": { "filePath": "#.env#" }, "expect": "block", "expectRule": "GG-ENV-001", "note": "emacs autosave of .env" },
    { "id": "BYP-BAK-003", "category": "backup-names", "tool": "bash", "input": { "command": "cat id_rsa~" }, "expect": "block", "expectRule": "GGR-READ", "note": "backup of an SSH private key" },
